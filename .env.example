# Any OpenAI compatible chat API works. Defaults target Google Gemini on the free tier.
# Create a key at https://aistudio.google.com/apikey and paste it below.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2

# Optional: replay the agent at another moment (ISO date or datetime, Campo Grande time).
# EMPORIO_TODAY=2026-03-20T10:30
